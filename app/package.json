{
  "name": "claude-notifications-tray",
  "version": "0.1.0",
  "description": "Tray app for the claude-notifications Claude Code plugin — quick toggle channels, edit config, send test notifications.",
  "main": "main.js",
  "author": {
    "name": "Fady Mondy",
    "email": "engfadymondy@gmail.com",
    "url": "https://github.com/fadymondy"
  },
  "license": "MIT",
  "homepage": "https://github.com/fadymondy/claude-notifications",
  "repository": {
    "type": "git",
    "url": "https://github.com/fadymondy/claude-notifications.git"
  },
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on tcp:5173 && CN_DEV_URL=http://localhost:5173 electron . --dev\"",
    "build:renderer": "vite build",
    "test": "node test/smoke.js",
    "lint": "node -c main.js && node -c preload.js && node -c config.js && node -c channels.js && node -c icon.js",
    "icons": "node build/generate-icons.js",
    "pack": "npm run icons && npm run build:renderer && electron-builder --dir",
    "dist": "npm run icons && npm run build:renderer && electron-builder",
    "dist:mac": "npm run icons && npm run build:renderer && electron-builder --mac",
    "dist:win": "npm run icons && npm run build:renderer && electron-builder --win",
    "dist:linux": "npm run icons && npm run build:renderer && electron-builder --linux"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.fadymondy.claude-notifications",
    "productName": "Claude Notifications",
    "copyright": "Copyright © 2026 Fady Mondy",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "channels.js",
      "icon.js",
      "renderer/dist/**/*",
      "renderer/assets/logo.svg",
      "build/icons/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icons/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icons",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fadymondy",
        "repo": "claude-notifications"
      }
    ]
  }
}
