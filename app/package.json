{
  "name": "claude-notifications-tray",
  "version": "0.1.0",
  "description": "Tray app for the claude-notifications Claude Code plugin — quick toggle channels, edit config, send test notifications.",
  "main": "main.js",
  "author": {
    "name": "Fady Mondy",
    "email": "engfadymondy@gmail.com",
    "url": "https://github.com/fadymondy"
  },
  "license": "MIT",
  "homepage": "https://github.com/fadymondy/claude-notifications",
  "repository": {
    "type": "git",
    "url": "https://github.com/fadymondy/claude-notifications.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/smoke.js",
    "lint": "node -c main.js && node -c preload.js && node -c renderer/app.js && node -c config.js && node -c channels.js && node -c icon.js",
    "icons": "node build/generate-icons.js",
    "pack": "npm run icons && electron-builder --dir",
    "dist": "npm run icons && electron-builder",
    "dist:mac": "npm run icons && electron-builder --mac",
    "dist:win": "npm run icons && electron-builder --win",
    "dist:linux": "npm run icons && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.fadymondy.claude-notifications",
    "productName": "Claude Notifications",
    "copyright": "Copyright © 2026 Fady Mondy",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "channels.js",
      "icon.js",
      "renderer/**/*",
      "build/icons/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icons/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icons",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fadymondy",
        "repo": "claude-notifications"
      }
    ]
  }
}
